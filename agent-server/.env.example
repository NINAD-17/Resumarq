# MongoDB
MONGODB_URI=

# Redis (e.g. redis://default:password@redis-12345.c12.us-east-1-9.ec2.redns.redis-cloud.com:12345 or redis://localhost:6379)
REDIS_URL=redis://localhost:6379
REDIS_QUEUE_NAME=resumarq:jobs
MAX_CONCURRENT_TASKS=2

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET_NAME=

# Google Gemini API
GOOGLE_API_KEY=

# Model configuration (optional — defaults in config.py are used if not set)
MODEL_PROVIDER=google_genai
MODEL_LITE=gemini-3.5-flash
MODEL_FLASH=gemini-3.5-flash
MODEL_PRO=gemini-3.5-flash
