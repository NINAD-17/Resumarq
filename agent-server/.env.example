# MongoDB
MONGODB_URI=

# Redis (e.g. redis://default:password@redis-12345.c12.us-east-1-9.ec2.redns.redis-cloud.com:12345 or redis://localhost:6379)
REDIS_URL=redis://localhost:6379
REDIS_QUEUE_NAME=resumarq:jobs
MAX_CONCURRENT_TASKS=2

# Storage Configuration (switch between "s3" or "cloudinary")
STORAGE_PROVIDER=s3

# AWS S3 (Optional if using Cloudinary)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET_NAME=

# Cloudinary (Optional if using AWS S3)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# or direct URL: CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Google Gemini API
GOOGLE_API_KEY=

# Model configuration (optional — defaults in config.py are used if not set)
MODEL_PROVIDER=google_genai
MODEL_LITE=gemini-3.5-flash
MODEL_FLASH=gemini-3.5-flash
MODEL_PRO=gemini-3.5-flash

# LangSmith Observability (Optional — Free 5,000 traces/mo at smith.langchain.com)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=resumarq-agent-server
