# MongoDB 
MONGODB_URI=

# Redis (e.g. redis://default:password@redis-12345.c12.us-east-1-9.ec2.redns.redis-cloud.com:12345 or redis://localhost:6379)
REDIS_URL=redis://localhost:6379
REDIS_QUEUE_NAME=resumarq:jobs

# Better-Auth Config
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000 # Base URL of your app

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URLs (accessible in browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend Email Service (https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Storage Configuration (switch between "s3" or "cloudinary")
STORAGE_PROVIDER=s3

# AWS S3 Configuration (Optional if using Cloudinary)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET_NAME=

# Cloudinary Configuration (Optional if using AWS S3)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# or direct URL: CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Recruiter Demo Access
RECRUITER_TOKEN=
